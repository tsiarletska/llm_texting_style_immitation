# Copy to .env (or ~/.config/cognition.env) and fill in only the providers you use.
# Short names (GROQ, GEMINI, CLAUDE, ...) and full names (GROQ_API_KEY, ...) both work.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
MAMAY_API_KEY=
# vLLM server you run yourself (e.g. on a rented GPU)
VLLM_BASE_URL=
RUNPOD_VLLM_KEY=
